---
// Shared layout for every page. Handles the head, nav, footer, and base styles.
// Pass a unique title and description from each page for SEO.

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/writing", label: "Writing" },
  { href: "/contact", label: "Contact" },
];

// Marks a nav link as current for styling and screen readers.
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Arhan Sibal",
  url: "https://arhansibal.com",
  email: "mailto:arhansibal10@gmail.com",
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "University of Michigan, Ross School of Business",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Indraprastha Institute of Information Technology Delhi",
    },
  ],
  knowsAbout: [
    "Business strategy",
    "Operations",
    "Business analytics",
    "Product management",
    "Applied AI",
  ],
  sameAs: [
    "https://www.linkedin.com/in/arhan-sibal",
    "https://github.com/Arhan-sibal",
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(currentPath, "https://arhansibal.com")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(currentPath, "https://arhansibal.com")} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={personSchema} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header">
      <nav aria-label="Main">
        <a class="wordmark" href="/">Arhan Sibal</a>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <a href="mailto:arhansibal10@gmail.com">arhansibal10@gmail.com</a>
        <span aria-hidden="true"> · </span>
        <a href="https://www.linkedin.com/in/arhan-sibal" rel="me">LinkedIn</a>
        <span aria-hidden="true"> · </span>
        <a href="https://github.com/Arhan-sibal" rel="me">GitHub</a>
        <span aria-hidden="true"> · </span>
        <a href="/resume">Resume</a>
      </p>
      <p class="colophon">© {new Date().getFullYear()} Arhan Sibal</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1d1d1b;
    --ink-soft: #4f4d49;
    --paper: #faf8f4;
    --line: #e3dfd7;
    --accent: #205c45;
    --measure: 38rem;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      Helvetica, Arial, sans-serif;
    font-size: 17px;
    line-height: 1.65;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0 auto;
    max-width: 44rem;
    padding: 0 1.25rem;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  h1,
  h2,
  h3 {
    font-family: "Iowan Old Style", Palatino, "Palatino Linotype", Georgia,
      serif;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 1rem;
  }

  .skip-link:focus {
    left: 1rem;
    z-index: 10;
  }

  .site-header {
    padding: 1.5rem 0 1rem;
    border-bottom: 1px solid var(--line);
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
  }

  .wordmark {
    font-family: "Iowan Old Style", Palatino, "Palatino Linotype", Georgia,
      serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  .site-header ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header li a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .site-header li a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .site-header li a[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
  }

  main {
    flex: 1;
    padding: 2.5rem 0 3rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 1.25rem 0 2rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .site-footer p {
    margin: 0.25rem 0;
  }

  .colophon {
    font-size: 0.85rem;
  }

  @media (max-width: 480px) {
    html {
      font-size: 16px;
    }
  }
</style>
